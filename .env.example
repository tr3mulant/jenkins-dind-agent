# Copy to .env next to docker-compose.yml, then: chmod 600 .env
# (JENKINS_SECRET is a credential -- .env is gitignored at the repo root.)

# Controller URL, including any path prefix if Jenkins isn't at the domain root.
JENKINS_URL=https://test.irongateenterprises.com/

# Must match the node name you created in Jenkins exactly.
JENKINS_AGENT_NAME=dowscripts-docker

# From Manage Jenkins > Nodes > <node> after saving. Rotate by deleting and
# recreating the node.
JENKINS_SECRET=

# --- Image build ------------------------------------------------------------

# No PHP_VERSION or NODE_MAJOR -- the agent image is the Docker CLI only.
JENKINS_AGENT_TAG=latest-jdk21
AGENT_IMAGE_TAG=latest

# --- Optional ---------------------------------------------------------------

# Caps the dind daemon, so it caps every CI container at once. Check `free -m`
# before raising: the controller shares this box.
BUILD_MEM_LIMIT=1g

# Copy to .env next to docker-compose.yml, then: chmod 600 .env
# (JENKINS_SECRET is a credential -- .env is gitignored.)

# --- Connection -------------------------------------------------------------

# Controller URL, including any path prefix if Jenkins isn't at the domain root.
JENKINS_URL=https://jenkins.example.com/

# Must match the node name you created in Jenkins exactly. No default -- a
# wrong value here shows up as a node that never connects.
JENKINS_AGENT_NAME=

# From Manage Jenkins > Nodes > <node> after saving. Rotate by deleting and
# recreating the node.
JENKINS_SECRET=

# --- Naming -----------------------------------------------------------------

# Compose project name; also prefixes the container and volume names. Change it
# only if you run more than one of these stacks on the same host.
STACK_NAME=jenkins-dind-agent

# --- Image build ------------------------------------------------------------

# No language toolchain -- the agent image is the Docker CLI only.
JENKINS_AGENT_TAG=latest-jdk21
AGENT_IMAGE=jenkins-dind-agent
AGENT_IMAGE_TAG=latest

# Keep the major aligned with the docker-ce-cli the agent image installs.
DIND_TAG=29-dind

# --- Resources --------------------------------------------------------------

# Caps the dind daemon, so it caps every container every job starts, all at
# once. Check `free -m` first, and remember the controller may share this box.
BUILD_MEM_LIMIT=4g
